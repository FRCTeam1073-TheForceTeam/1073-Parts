# Copy to /etc/1073-parts/parts.env (deploy/install.sh does this for you).
# This file holds secrets: keep it readable only by root and the parts user (mode 0640).

# Port the app listens on. Apache proxies to this. Dev uses 3000, so production uses 8090.
PORT=8090

# Where the database, uploaded photos and part files are kept. Must be writable by the parts user.
DATA_DIR=/var/lib/1073-parts

# Required before the first admin account can be created. Choose something only you know.
SETUP_CODE=change-me

# The app sits behind Apache, so trust the X-Forwarded-* headers Apache sends.
TRUST_PROXY=1
