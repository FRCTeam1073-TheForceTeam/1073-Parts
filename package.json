{
  "name": "parts-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "FRC 1073 parts ordering and inventory tracker",
  "type": "module",
  "main": "server/start.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/start.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.js create backup.tar",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --import ./test/unit/helpers/forbid-db.js --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.js\"",
    "test:db": "node --disable-warning=ExperimentalWarning --test \"test/db/**/*.test.js\"",
    "test:coverage": "node --import ./test/unit/helpers/forbid-db.js --disable-warning=ExperimentalWarning --test --experimental-test-coverage \"test/unit/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "occt-import-js": "^0.0.23",
    "three": "^0.160.1"
  }
}
